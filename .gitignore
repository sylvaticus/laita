# Signed and packaged builds
web-ext-artifacts/

# browser/dist-chrome/ is deliberately NOT ignored: it is committed so that Chrome users
# can download the repository and "Load unpacked" without running anything. It is a pure
# copy of src/ with the Chrome manifest, and test/unit/dist-chrome.test.mjs fails if it
# drifts out of step.

# AMO / signing credentials - never commit these.
# The JWT issuer and secret from addons.mozilla.org belong outside the repository
# entirely; a sibling ../secrets/ directory, your shell profile or a password manager.
.env
.env.*
*.pem
*.key
secrets/
web-ext-config.local.*

# Node tooling lives at the repository root; browser/ and vscode/ stay free of it.
node_modules/
# package-lock.json IS committed: CI must install the exact versions that were tested,
# and "web-ext lint reports 0 warnings" is meaningless against a moving target.

# Editors and OS
# Not a blanket .vscode/ rule: vscode/.vscode/launch.json is the launch configuration
# that makes F5 work, and without it the extension appears to do nothing when you press
# it. That cost an afternoon once already.
/.vscode/
.idea/
*.swp
.DS_Store

# Scratch
*.log

# VS Code extension packages
vscode/*.vsix
