{
  "manifest_version": 3,
  "name": "LAITA - Local AI Text Assistant",
  "version": "0.4.4",
  "default_locale": "en",
  "description": "Local AI proofreading and rewriting for any web form, powered by your own Ollama models. Nothing leaves your machine.",
  "author": "Antonello Lobianco",
  "homepage_url": "https://github.com/sylvaticus/laita",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "src/background/main.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "src/content/common.js",
        "src/content/segment.js",
        "src/content/textmap.js",
        "src/content/overlay.js",
        "src/content/card.js",
        "src/content/transform.js",
        "src/content/main.js"
      ]
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "LAITA - Local AI Text Assistant",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "check-now": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Check the whole focused field, or stop checking it"
    },
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Enable / disable Local AI Text Assistant on this site"
    },
    "transform-selection": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Transform the selected text with an instruction"
    }
  }
}
