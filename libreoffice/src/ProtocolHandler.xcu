<?xml version="1.0" encoding="UTF-8"?>
<!-- Routes our own URL scheme to the Dispatcher component. Without this the toolbar
     buttons are drawn and do nothing at all, silently. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="ProtocolHandler" oor:package="org.openoffice.Office">
  <node oor:name="HandlerSet">
    <node oor:name="org.lobianco.laita.Dispatcher" oor:op="replace">
      <prop oor:name="Protocols" oor:type="oor:string-list">
        <value>org.lobianco.laita.command:*</value>
      </prop>
    </node>
  </node>
</oor:component-data>
