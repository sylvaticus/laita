<?xml version="1.0" encoding="UTF-8"?>
<!--
  Where LAITA appears. Two places on purpose:

  A menu under Tools, which is always there and costs no screen space, and a toolbar,
  which is faster but takes a row. The toolbar can be turned off in View > Toolbars
  without losing any functionality - everything it offers is in the menu too.

  Context decides which applications each command appears in. Proofreading only ever
  happens in Writer - Calc, Impress and Draw never call a grammar checker, measured - so
  Check this document and Stop checking are Writer-only. Transform works on a selection
  and is offered everywhere.
-->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">

    <node oor:name="OfficeMenuBar">
      <node oor:name="org.lobianco.laita" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="en">LAITA</value>
        </prop>
        <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
        <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument</value></prop>
        <node oor:name="Submenu">
        <node oor:name="n1" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>org.lobianco.laita.command:transform</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en">Transform selection...</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument</value></prop>
        </node>
        <node oor:name="n2" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>org.lobianco.laita.command:checkdocument</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en">Check this document</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
        </node>
        <node oor:name="n3" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>org.lobianco.laita.command:stop</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en">Stop checking</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
        </node>
        <node oor:name="n4" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>org.lobianco.laita.command:options</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en">Options...</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument</value></prop>
        </node>
        </node>
      </node>
    </node>

    <node oor:name="OfficeToolBar">
      <node oor:name="org.lobianco.laita.toolbar" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="en">LAITA</value>
        </prop>
        <node oor:name="m1" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>org.lobianco.laita.command:transform</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en">Transform selection...</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument</value></prop>
        </node>
        <node oor:name="m2" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>org.lobianco.laita.command:checkdocument</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en">Check this document</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
        </node>
        <node oor:name="m3" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>org.lobianco.laita.command:stop</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en">Stop checking</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
        </node>
        <node oor:name="m4" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>org.lobianco.laita.command:options</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en">Options...</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument</value></prop>
        </node>
      </node>
    </node>

  </node>
</oor:component-data>
