<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<!-- The standalone options dialog, opened from the toolbar.
     Same control ids as options.xdl, so one pair of load/save functions serves both.
     This one exists because the Tools > Options tree integration never appeared, and a
     dialog we open ourselves is one less thing that can fail silently. -->
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog"
            xmlns:script="http://openoffice.org/2000/script"
            dlg:id="optionsdialog" dlg:left="80" dlg:top="40" dlg:width="260" dlg:height="248"
            dlg:closeable="true" dlg:moveable="true" dlg:withtitlebar="true"
            dlg:title="LAITA - Local AI Text Assistant">
 <dlg:bulletinboard>

  <dlg:fixedline dlg:id="l1" dlg:tab-index="0" dlg:left="4" dlg:top="3" dlg:width="252" dlg:height="10" dlg:value="Ollama"/>
  <dlg:text dlg:id="tEndpoint" dlg:tab-index="1" dlg:left="8" dlg:top="17" dlg:width="70" dlg:height="10" dlg:value="Endpoint"/>
  <dlg:textfield dlg:id="Endpoint" dlg:tab-index="2" dlg:left="80" dlg:top="15" dlg:width="172" dlg:height="12"/>
  <dlg:text dlg:id="tModel" dlg:tab-index="3" dlg:left="8" dlg:top="32" dlg:width="70" dlg:height="10" dlg:value="Model"/>
  <!-- A dropdown, filled from /api/tags when the dialog opens, but still editable: a
       model can be pulled while the dialog is open, and Ollama may be unreachable. -->
  <dlg:combobox dlg:id="Model" dlg:tab-index="4" dlg:left="80" dlg:top="30" dlg:width="120" dlg:height="12" dlg:spin="true"/>
  <dlg:button dlg:id="btnTest" dlg:tab-index="5" dlg:left="204" dlg:top="30" dlg:width="48" dlg:height="12" dlg:value="Test">
   <!-- script:language="UNO" and the vnd.sun.star.UNO: prefix, with NO script:location.
        Every other spelling makes createDialogWithHandler throw
        WrappedTargetRuntimeException at CREATION time, with nothing naming the
        event as the cause - bisected against a live LibreOffice to find it. -->
   <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:onTest" script:language="UNO"/>
  </dlg:button>
  <dlg:text dlg:id="Status" dlg:tab-index="26" dlg:left="8" dlg:top="45" dlg:width="244" dlg:height="10" dlg:value=""/>
  <dlg:text dlg:id="tKeep" dlg:tab-index="5" dlg:left="8" dlg:top="59" dlg:width="70" dlg:height="10" dlg:value="Keep loaded for"/>
  <dlg:textfield dlg:id="KeepAlive" dlg:tab-index="6" dlg:left="80" dlg:top="57" dlg:width="60" dlg:height="12"/>
  <dlg:checkbox dlg:id="Think" dlg:tab-index="7" dlg:left="146" dlg:top="58" dlg:width="106" dlg:height="10" dlg:value="Let the model think" dlg:checked="false"/>

  <dlg:fixedline dlg:id="l2" dlg:tab-index="8" dlg:left="4" dlg:top="75" dlg:width="252" dlg:height="10" dlg:value="When to check"/>
  <dlg:checkbox dlg:id="Enabled" dlg:tab-index="9" dlg:left="8" dlg:top="89" dlg:width="120" dlg:height="10" dlg:value="Enabled" dlg:checked="true"/>
  <dlg:checkbox dlg:id="CheckAsYouType" dlg:tab-index="10" dlg:left="132" dlg:top="89" dlg:width="120" dlg:height="10" dlg:value="Check as you type" dlg:checked="true"/>
  <dlg:text dlg:id="tDeb" dlg:tab-index="11" dlg:left="8" dlg:top="104" dlg:width="110" dlg:height="10" dlg:value="Typing pause before checking (ms)"/>
  <dlg:textfield dlg:id="DebounceMs" dlg:tab-index="12" dlg:left="192" dlg:top="102" dlg:width="60" dlg:height="12"/>
  <dlg:text dlg:id="tMin" dlg:tab-index="13" dlg:left="8" dlg:top="119" dlg:width="110" dlg:height="10" dlg:value="Ignore paragraphs shorter than"/>
  <dlg:textfield dlg:id="MinChars" dlg:tab-index="14" dlg:left="192" dlg:top="117" dlg:width="60" dlg:height="12"/>
  <dlg:text dlg:id="tMax" dlg:tab-index="15" dlg:left="8" dlg:top="134" dlg:width="110" dlg:height="10" dlg:value="Maximum characters per check"/>
  <dlg:textfield dlg:id="MaxChars" dlg:tab-index="16" dlg:left="192" dlg:top="132" dlg:width="60" dlg:height="12"/>

  <dlg:fixedline dlg:id="l3" dlg:tab-index="17" dlg:left="4" dlg:top="150" dlg:width="252" dlg:height="10" dlg:value="What to suggest"/>
  <dlg:checkbox dlg:id="CatError" dlg:tab-index="18" dlg:left="8" dlg:top="164" dlg:width="76" dlg:height="10" dlg:value="Errors" dlg:checked="true"/>
  <dlg:checkbox dlg:id="CatStyle" dlg:tab-index="19" dlg:left="88" dlg:top="164" dlg:width="76" dlg:height="10" dlg:value="Style" dlg:checked="true"/>
  <dlg:checkbox dlg:id="CatRephrase" dlg:tab-index="20" dlg:left="168" dlg:top="164" dlg:width="84" dlg:height="10" dlg:value="Rephrasings" dlg:checked="true"/>
  <dlg:text dlg:id="tExtra" dlg:tab-index="21" dlg:left="8" dlg:top="181" dlg:width="244" dlg:height="10" dlg:value="Extra instructions for the model"/>
  <dlg:textfield dlg:id="ExtraInstructions" dlg:tab-index="22" dlg:left="8" dlg:top="193" dlg:width="244" dlg:height="26" dlg:multiline="true"/>

  <dlg:button dlg:id="btnOk" dlg:tab-index="23" dlg:left="146" dlg:top="228" dlg:width="52" dlg:height="14" dlg:value="OK" dlg:button-type="ok" dlg:default="true"/>
  <dlg:button dlg:id="btnCancel" dlg:tab-index="24" dlg:left="202" dlg:top="228" dlg:width="52" dlg:height="14" dlg:value="Cancel" dlg:button-type="cancel"/>

 </dlg:bulletinboard>
</dlg:window>
